            "exec": [
              "pm.test('POST refusé en 405', function () { pm.response.to.have.status(405); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Charger le formulaire et le jeton CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/connexion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Le formulaire de connexion est disponible', function () { pm.response.to.have.status(200); });",
              "const token = pm.response.text().match(/name=\"_csrf_token\"\\s+value=\"([^\"]+)\"/);",
              "pm.test('Le formulaire contient un jeton CSRF', function () { pm.expect(token).not.to.be.null; });",
              "if (token) pm.environment.set('csrfToken', token[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Authentifier le passager",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "_username",
              "value": "{{passengerEmail}}"
            },
            {
              "key": "_password",
              "value": "{{passengerPassword}}"
            },
            {
              "key": "_csrf_token",
              "value": "{{csrfToken}}"
            }
          ]
        },
        "url": "{{baseUrl}}/connexion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La connexion aboutit et la session est conservée', function () { pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('Rechercher un trajet'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Réserver une place (succès JSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"trajetId\": {{tripId}}, \"nbPlaces\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/reservation/new-ajax"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La réservation retourne 200 JSON', function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
              "const json = pm.response.json();",
              "pm.test('La réponse confirme la réservation et son prix', function () { pm.expect(json.success).to.eql(true); pm.expect(json.prixTotal).to.eql(25); pm.expect(json.reservationId).to.be.a('number'); });",
              "pm.test('En-tête Content-Type JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05b — État après réservation : la recherche affiche 3 places pour le trajet (relecture HTTP)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/trajet/recherche?villeDepart={{fromCity}}&destination={{toCity}}&dateDepart={{fixtureDate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const card = pm.response.text().match(new RegExp('data-trajet-id=\"' + pm.environment.get('tripId') + '\" data-places-max=\"(\\\\d+)\"'));",
              "pm.test('Le trajet est toujours affiché', function () { pm.expect(card).to.not.be.null; });",
              "pm.test('Stock décrémenté de 4 à 3 (CA-08)', function () { pm.expect(Number(card[1])).to.eql(3); });"
            ]
          }
        }
      ]
    },
