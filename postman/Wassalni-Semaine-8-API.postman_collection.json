{
  "info": {
    "_postman_id": "c1b4ce4b-f694-4d4a-9fd8-50a2b3c5988d",
    "name": "Wassalni — Semaine 8 — Tests de l'API JSON",
    "description": "Surface JSON réellement exposée par WASSALNI (aucune API REST versionnée) : POST /reservation/new-ajax, GET /health, GET /get-last-user-email, GET /check-verification-status. Chaque requête porte des assertions sur le code HTTP, les en-têtes et le corps JSON. Les identifiants EX/CA/ANO renvoient au dossier de test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Trouver le trajet reproductible",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trajet/recherche?villeDepart={{fromCity}}&destination={{toCity}}&dateDepart={{fixtureDate}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trajet",
            "recherche"
          ],
          "query": [
            {
              "key": "villeDepart",
              "value": "{{fromCity}}"
            },
            {
              "key": "destination",
              "value": "{{toCity}}"
            },
            {
              "key": "dateDepart",
              "value": "{{fixtureDate}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La recherche de fixture renvoie 200', function () { pm.response.to.have.status(200); });",
              "const matches = [...pm.response.text().matchAll(/class=\"result-card\" data-trajet-id=\"(\\d+)\"/g)];",
              "pm.test('Un seul trajet reproductible est trouvé', function () { pm.expect(matches).to.have.lengthOf(1); });",
              "if (matches.length === 1) pm.environment.set('tripId', matches[0][1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Refuser un visiteur anonyme",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"trajetId\": {{tripId}}, \"nbPlaces\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/reservation/new-ajax"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Une réservation anonyme est redirigée vers la connexion', function () { pm.response.to.have.status(302); });",
              "pm.test('La redirection mène au formulaire de connexion', function () { pm.expect(pm.response.headers.get('Location')).to.include('/connexion'); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "02b — CA-14 : /get-last-user-email sans connexion ne divulgue aucune adresse (ANO-22)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/get-last-user-email"
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Accès refusé sans connexion (302, 401 ou 403)', function () { pm.expect([302, 401, 403]).to.include(pm.response.code); });",
              "pm.test('Aucune adresse e-mail dans la réponse', function () { pm.expect(pm.response.text()).to.not.match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[a-z]{2,}/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02c — CA-14 : /check-verification-status sans connexion est refusé (ANO-22)",
      "request": {
