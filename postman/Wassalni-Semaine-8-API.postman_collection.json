    {
      "name": "11 — API REST : créer une réclamation (passager) → 201 + Location",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reclamations",
        "body": {
          "mode": "raw",
          "raw": "{\"sujet\": \"Retard important\", \"message\": \"Le conducteur est arrivé avec 40 minutes de retard.\", \"trajetId\": {{tripId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test(\"En-tête Location vers la ressource créée\", function () { pm.expect(pm.response.headers.get('Location')).to.eql('/api/reclamations/' + json.id); });",
              "pm.test(\"Statut initial EN_ATTENTE, trajet rattaché\", function () { pm.expect(json.statut).to.eql('EN_ATTENTE'); pm.expect(json.trajetId).to.eql(Number(pm.environment.get('tripId'))); });",
              "pm.environment.set('reclamationId', json.id);"
            ]
          }
        }
      ]
    },
